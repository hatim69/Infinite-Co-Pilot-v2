{
  "name": "infinite-copilot-desktop",
  "version": "1.0.0",
  "description": "Infinite Co-Pilot Desktop Companion for Mac and Windows",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build:mac": "ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --mac",
    "build:win": "ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --win",
    "build:all": "ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder -mw"
  },
  "author": "Infinite Co-Pilot",
  "license": "ISC",
  "dependencies": {
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "electron": "^34.5.8",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.infinitecopilot.desktop",
    "productName": "Infinite Co-Pilot",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "src/**/*",
      "build/**/*",
      "node_modules/ws/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.simulation-games",
      "target": [
        {
          "target": "default",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
